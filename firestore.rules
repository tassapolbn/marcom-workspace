rules_version = '2';

// =====================================================================
// HeadStart MARCOM Workspace - Firestore Security Rules (least privilege)
//
// Design principles
//  1. No broad top-level wildcard. Every collection the app uses is either
//     matched explicitly below, or must appear in the member-collection
//     whitelist. Unknown / future collections are DENIED by default.
//  2. Overlapping allow rules are additive in Firestore, so the final
//     member-collection block explicitly EXCLUDES every collection that has
//     its own match above it (the whitelist contains member collections
//     only). Nothing here re-broadens an earlier rule.
//  3. The public Request Centre has NO direct database access. Submissions
//     and status lookups go through Netlify Functions using the Admin SDK,
//     which bypasses these rules on the server, where input is validated.
//  4. Deploy order matters: deploy the new site + functions FIRST, confirm
//     the Request Centre works, then deploy these rules.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------
    function signedIn()  { return request.auth != null; }
    // Relaxed on purpose: password sign-ins are accepted without email
    // verification, because the acl list below is the real gate that
    // decides who may enter. (Tighten again later if everyone uses
    // Google school accounts: require sign_in_provider == 'google.com'
    // or email_verified == true.)
    function trustedSignIn() {
      return signedIn();
    }
    function userEmail() { return request.auth.token.email.lower(); }
    function aclRef()    { return /databases/$(database)/documents/acl/$(userEmail()); }
    function hasAcl()    { return trustedSignIn() && exists(aclRef()); }
    function aclData()   { return get(aclRef()).data; }
    function authorized(){ return hasAcl() && aclData().get('disabled', false) == false; }
    function roleVal()   { return authorized() ? aclData().role : 'none'; }
    function isAdmin()   { return roleVal() == 'admin'; }

    // Workspace prefix each role owns.
    function ws() {
      return isAdmin()             ? 'admin'
        : roleVal() == 'designer'  ? 'dew'
        : roleVal() == 'media'     ? 'o'
        : roleVal() == 'junior'    ? 'junior'
        : 'none';
    }

    // Collections the signed-in member may WRITE (their own workspace).
    function ownsCollection(c) {
      return c == ws() + '_tasks'     ||
             c == ws() + '_links'     ||
             c == ws() + '_notes'     ||
             c == ws() + '_events'    ||
             c == ws() + '_sick'      ||
             c == ws() + '_lieu'      ||
             c == ws() + '_assets'    ||
             c == ws() + '_settings'  ||
             c == ws() + '_templates';   // fixes: O could not save recurring templates
    }

    // Full whitelist of member workspace collections the app uses.
    // Anything NOT in this list and NOT matched explicitly below is denied.
    function knownMemberCollection(c) {
      return c in [
        'boss_tasks','boss_links','boss_notes','boss_settings',
        'best_tasks','best_links','best_notes','best_dayoffs',
        'dew_tasks','dew_links','dew_notes','dew_events','dew_sick','dew_lieu','dew_assets','dew_settings','dew_templates',
        'o_tasks','o_links','o_notes','o_events','o_sick','o_lieu','o_assets','o_settings','o_templates',
        'junior_tasks','junior_links','junior_notes','junior_events','junior_sick','junior_lieu','junior_settings','junior_templates'
      ];
    }

    // ---------------- access control list ----------------
    // A user may read ONLY their own ACL record (needed at login).
    // Only an admin may list users or grant, change, or revoke access.
    match /acl/{email} {
      allow get:    if isAdmin() || (trustedSignIn() && email == userEmail());
      allow list:   if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------- public request queue ----------------
    // Created ONLY by the server (Admin SDK). Team members may read, update
    // a fixed set of workflow fields, and delete. Requester identity and the
    // original submission content are immutable from the client.
    match /requests/{id} {
      allow read:   if authorized();
      allow create: if false;   // server only
      allow update: if authorized()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','readByAssignee','taskId','completedAtIso'])
        && request.resource.data.get('status','Submitted') in
             ['Submitted','Under Review','Needs Clarification','Accepted',
              'In Progress','Awaiting Approval','Completed','Rejected'];
      allow delete: if isAdmin()
        || (authorized() && resource.data.get('assignedTo','') == ws());
    }

    // Automation failure log written by the server; admin reads, nobody edits.
    match /rc_failures/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ---------------- shared team chat ----------------
    // authorEmail must match the signed-in user and can never be changed,
    // so nobody can post or edit messages as someone else.
    match /chat_messages/{id} {
      allow read: if authorized();
      allow create: if authorized()
        && request.resource.data.keys().hasOnly(['text','authorEmail','authorName','authorWs','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000
        && request.resource.data.authorEmail == userEmail();
      allow update: if (isAdmin() || (authorized() && resource.data.get('authorEmail','') == userEmail()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      allow delete: if isAdmin()
        || (authorized() && resource.data.get('authorEmail','') == userEmail());
    }

    // ---------------- internal team request log (app upgrades etc.) ----------------
    match /team_requests/{id} {
      allow read: if authorized();
      allow create: if authorized()
        && request.resource.data.keys().hasOnly(['text','category','status','authorEmail','authorName','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000
        && request.resource.data.status == 'open'
        && request.resource.data.authorEmail == userEmail();
      allow update: if
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','status','editedAt'])
          && request.resource.data.get('status','open') in ['open','in_progress','done'])
        || (authorized()
          && resource.data.get('authorEmail','') == userEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000);
      allow delete: if isAdmin()
        || (authorized() && resource.data.get('authorEmail','') == userEmail());
    }

    // ---------------- activity / audit log ----------------
    // Append-only for everyone INCLUDING the admin: history cannot be
    // silently rewritten. The admin may delete an incorrect entry.
    match /activity/{id} {
      allow read: if authorized();
      allow create: if authorized()
        && request.resource.data.get('actorEmail','') == userEmail();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------- department-wide settings ----------------
    // Team names, petty cash meta, announcements, resources, brand library,
    // lieu configuration. Everyone reads, only the admin writes.
    match /dept_settings/{doc} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ---------------- Boss-owned ledgers (admin writes only) ----------------
    match /petty_cash/{id}   { allow read: if authorized(); allow write: if isAdmin(); }
    match /lieu_records/{id} { allow read: if authorized(); allow write: if isAdmin(); }
    match /sick_leave/{id}   { allow read: if authorized(); allow write: if isAdmin(); }

    // School events: shared store used by both Boss and the Junior Events
    // Coordinator (the app maps the junior workspace onto this collection).
    match /school_events/{id} {
      allow read:  if authorized();
      allow write: if isAdmin() || roleVal() == 'junior';
    }

    // SOP task templates: shared; maintained by Boss and the Junior
    // Events Coordinator.
    match /sop_templates/{doc} {
      allow read:  if authorized();
      allow write: if isAdmin() || roleVal() == 'junior';
    }

    // ---------------- per-member workspace collections ----------------
    // Strict whitelist: unknown collection names are denied even for the
    // admin, so a typo or an abandoned experiment cannot open a back door.
    // READ:  any authorised team member (Team Overview, workload, availability).
    // WRITE: the workspace owner, or the admin.
    match /{collection}/{id} {
      allow read:  if authorized() && knownMemberCollection(collection);
      allow write: if knownMemberCollection(collection)
        && (isAdmin() || (authorized() && ownsCollection(collection)));
    }
  }
}
