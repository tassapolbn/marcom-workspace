rules_version = '2';

// =====================================================================
// HeadStart MARCOM Workspace - Firestore Security Rules (least privilege)
//
// Design principles
//  1. No broad top-level wildcard. Every collection the app uses is either
//     matched explicitly below, or matches the member-collection PATTERN in
//     knownMemberCollection(). Unknown collections are DENIED by default.
//  2. The member-collection check is a PATTERN, not a hand-typed list, so a
//     newly added collection such as junior_settings can never be accidentally
//     left out (this previously blocked calendar saves for a member). Write is
//     still limited to a member's own workspace, or the admin, by ownsCollection.
//  3. Overlapping allow rules are additive in Firestore. Collections that have
//     their own explicit match above (event_tasks, chat_messages, dept_settings,
//     school_events, sop_templates, the per-member _lieu / _sick) are granted
//     exactly the same or narrower access by the pattern rule, so nothing is
//     re-broadened.
//  4. The public Request Centre has NO direct database access. Submissions and
//     status lookups go through Netlify Functions using the Admin SDK, which
//     bypasses these rules on the server, where input is validated.
//  5. Deploy order matters: deploy the new site + functions FIRST, confirm the
//     Request Centre works, then PUBLISH these rules.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- helpers ----------------
    function signedIn()  { return request.auth != null; }
    // Relaxed on purpose: password sign-ins are accepted without email
    // verification, because the acl list below is the real gate that decides
    // who may enter. (Tighten later if everyone uses Google school accounts:
    // require sign_in_provider == 'google.com' or email_verified == true.)
    function trustedSignIn() {
      return signedIn();
    }
    function userEmail() { return request.auth.token.email.lower(); }
    function aclRef()    { return /databases/$(database)/documents/acl/$(userEmail()); }
    function hasAcl()    { return trustedSignIn() && exists(aclRef()); }
    function aclData()   { return get(aclRef()).data; }
    function authorized(){ return hasAcl() && aclData().get('disabled', false) == false; }
    function roleVal()   { return authorized() ? aclData().get('role', 'none') : 'none'; }
    function isAdmin()   { return roleVal() == 'admin'; }

    // Workspace prefix each role owns.
    function ws() {
      return isAdmin()             ? 'admin'
        : roleVal() == 'designer'  ? 'dew'
        : roleVal() == 'media'     ? 'o'
        : roleVal() == 'junior'    ? 'junior'
        : 'none';
    }

    // Collections the signed-in member may WRITE (their own workspace only).
    function ownsCollection(c) {
      return c == ws() + '_tasks'     ||
             c == ws() + '_links'     ||
             c == ws() + '_notes'     ||
             c == ws() + '_events'    ||
             c == ws() + '_sick'      ||
             c == ws() + '_lieu'      ||
             c == ws() + '_assets'    ||
             c == ws() + '_settings'  ||
             c == ws() + '_templates';
    }

    // Is this one of the app's member workspace collections?
    // A PATTERN (every prefix x every suffix) so nothing can be left out. This
    // gates READ for the team and is a precondition for WRITE; the actual write
    // permission is still ownsCollection (own workspace) or admin, below.
    function knownMemberCollection(c) {
      return c.matches('^(boss|best|dew|o|junior)_(tasks|links|notes|events|sick|lieu|assets|settings|templates|dayoffs)$');
    }

    // ---------------- access control list ----------------
    // A user may read ONLY their own ACL record (needed at login).
    // Only an admin may list users or grant, change, or revoke access.
    match /acl/{email} {
      allow get:    if isAdmin() || (trustedSignIn() && email == userEmail());
      allow list:   if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------------- public request queue ----------------
    // Created ONLY by the server (Admin SDK). Team members may read, update a
    // fixed set of workflow fields, and delete. Requester identity and the
    // original submission content are immutable from the client.
    match /requests/{id} {
      allow read:   if authorized();
      allow create: if false;   // server only
      allow update: if authorized()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','readByAssignee','taskId','completedAtIso'])
        && request.resource.data.get('status','Submitted') in
             ['Submitted','Under Review','Needs Clarification','Accepted',
              'In Progress','Awaiting Approval','Completed','Rejected'];
      allow delete: if isAdmin()
        || (authorized() && resource.data.get('assignedTo','') == ws());
    }

    // Automation failure log written by the server; admin reads, nobody edits.
    match /rc_failures/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ---------------- Director requests from the shared team board ----------------
    // Written ONLY by the server (board-action.js), which checks the private share
    // token first. The board has no login, so nothing it sends may edit a task: a
    // request is a separate record the team reads and applies by hand.
    // Every authorised member reads them (the notification bell counts them). Only
    // the admin, or a member the request is addressed to, may close one, and the
    // closing write may touch nothing except the three handled fields, so the text
    // of a request can never be rewritten after the fact.
    match /director_notes/{id} {
      allow read:   if authorized();
      allow create: if false;   // server only
      allow update: if (isAdmin() || (authorized() && ws() in resource.data.get('owners', [])))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status','handledBy','handledAt'])
        && request.resource.data.get('status','new') in ['new','done'];
      allow delete: if isAdmin();
    }

    // ---------------- shared central event task board ----------------
    // Every authorised member may read and write every event task: this is a
    // shared internal board. Deletion is confirmed in the UI, and every write
    // is stamped with lastEditedBy so changes stay traceable.
    match /event_tasks/{id} {
      allow read:   if authorized();
      allow create: if authorized()
        && request.resource.data.get('createdBy','') == userEmail();
      allow update: if authorized()
        && request.resource.data.get('lastEditedBy','') == userEmail()
        && request.resource.data.get('createdBy', resource.data.get('createdBy','')) == resource.data.get('createdBy','');
      allow delete: if authorized();
    }

    // ---------------- shared team chat ----------------
    // authorEmail must match the signed-in user and can never be changed, so
    // nobody can post or edit messages as someone else. A message is either
    // plain text, or an image/GIF whose URL is stored on the message (text may
    // then be empty). Only the specific optional keys below are allowed, every
    // URL must be a string, so this stays least-privilege.
    match /chat_messages/{id} {
      allow read: if authorized();
      allow create: if authorized()
        && request.resource.data.keys().hasOnly(['text','authorEmail','authorName','authorWs','createdAt','type','imageUrl','gifUrl','width','height'])
        && request.resource.data.authorEmail == userEmail()
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.get('type','text') in ['text','image','gif']
        && (request.resource.data.get('type','text') == 'text'
              ? request.resource.data.text.size() > 0
              : true)
        && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
        && (!('gifUrl' in request.resource.data) || request.resource.data.gifUrl is string)
        && (!('width' in request.resource.data) || request.resource.data.width is number)
        && (!('height' in request.resource.data) || request.resource.data.height is number);
      allow update: if (isAdmin() || (authorized() && resource.data.get('authorEmail','') == userEmail()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 4000;
      allow delete: if isAdmin()
        || (authorized() && resource.data.get('authorEmail','') == userEmail());
    }

    // ---------------- internal team request log (app upgrades etc.) ----------------
    match /team_requests/{id} {
      allow read: if authorized();
      allow create: if authorized()
        && request.resource.data.keys().hasOnly(['text','category','status','authorEmail','authorName','createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 5000
        && request.resource.data.status == 'open'
        && request.resource.data.authorEmail == userEmail();
      allow update: if
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','status','editedAt'])
          && request.resource.data.get('status','open') in ['open','in_progress','needs_info','completed','rejected'])
        || (authorized()
          && resource.data.get('authorEmail','') == userEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000);
      allow delete: if isAdmin()
        || (authorized() && resource.data.get('authorEmail','') == userEmail());
    }

    // ---------------- activity / audit log ----------------
    // Append-only for everyone INCLUDING the admin: history cannot be silently
    // rewritten. The admin may delete an incorrect entry.
    match /activity/{id} {
      allow read: if authorized();
      allow create: if authorized()
        && request.resource.data.get('actorEmail','') == userEmail();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------------- department-wide settings ----------------
    // Team names, petty cash meta, announcements, resources, brand library,
    // lieu configuration, the shared chat photo uploader. Everyone reads, only
    // the admin writes.
    match /dept_settings/{doc} {
      allow read:  if authorized();
      allow write: if isAdmin();
    }

    // ---------------- Boss-owned ledgers (admin writes only) ----------------
    match /petty_cash/{id}   { allow read: if authorized(); allow write: if isAdmin(); }
    // Boss's own leave ledgers. Boss is the admin, so these stay admin-writable;
    // every other member owns their records in <workspace>_lieu / <workspace>_sick
    // and writes them through the member-collection rule at the end of this file.
    match /lieu_records/{id} { allow read: if authorized(); allow write: if isAdmin(); }
    match /sick_leave/{id}   { allow read: if authorized(); allow write: if isAdmin(); }

    // ONE shared Event Hub for the whole team: every authorised member may add
    // and edit events, because an event belongs to the department, not a person.
    match /school_events/{id} {
      allow read:  if authorized();
      allow write: if authorized();
    }

    // SOP task templates: shared; maintained by Boss and the Junior Events
    // Coordinator.
    match /sop_templates/{doc} {
      allow read:  if authorized();
      allow write: if isAdmin() || roleVal() == 'junior';
    }

    // ---------------- per-member leave records (explicit) ----------------
    // A tab owner always manages their own leave in lieu and sick leave. Stated
    // explicitly so this can never depend on the pattern rule below.
    match /dew_lieu/{id}    { allow read: if authorized(); allow write: if isAdmin() || roleVal() == 'designer'; }
    match /dew_sick/{id}    { allow read: if authorized(); allow write: if isAdmin() || roleVal() == 'designer'; }
    match /o_lieu/{id}      { allow read: if authorized(); allow write: if isAdmin() || roleVal() == 'media'; }
    match /o_sick/{id}      { allow read: if authorized(); allow write: if isAdmin() || roleVal() == 'media'; }
    match /junior_lieu/{id} { allow read: if authorized(); allow write: if isAdmin() || roleVal() == 'junior'; }
    match /junior_sick/{id} { allow read: if authorized(); allow write: if isAdmin() || roleVal() == 'junior'; }

    // ---------------- per-member workspace collections ----------------
    // READ:  any authorised team member (Team Overview, workload, availability).
    // WRITE: the workspace owner (ownsCollection), or the admin.
    // The pattern in knownMemberCollection covers every member collection, so a
    // member can always write their own _settings, _templates, _tasks, etc.
    match /{collection}/{id} {
      allow read:  if authorized() && knownMemberCollection(collection);
      allow write: if knownMemberCollection(collection)
        && (isAdmin() || (authorized() && ownsCollection(collection)));
    }
  }
}
